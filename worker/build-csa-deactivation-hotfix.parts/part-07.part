for (const [label, ok] of assertions) {
  if (!ok) throw new Error(`contract assertion failed: ${label}`);
}

fs.writeFileSync(outputPath, source, 'utf8');
const generatedWorkerPath = fileURLToPath(outputPath);
const check = spawnSync(process.execPath, ['--check', generatedWorkerPath], { encoding: 'utf8' });
if (check.status !== 0) {
  process.stderr.write(check.stdout || '');
  process.stderr.write(check.stderr || '');
  throw new Error('generated Worker failed node --check');
}
console.log('CSA deactivation hotfix generated and syntax-checked.');
